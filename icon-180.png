name: Update Astara Growth Radar data

on:
  schedule:
    - cron: "0 13 * * *" # 8:00 a.m. Perú
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Update data.json
        run: python scripts/update-data.py

      - name: Commit changes
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Update Astara Growth Radar data"
          file_pattern: data.json
